{
  "name": "@outloud/model",
  "title": "Model",
  "description": "A JavaScript library for mapping plain data to models.",
  "author": "Outloud (https://outloud.co)",
  "contributors": [
    "Andrej Adamcik"
  ],
  "license": "MIT",
  "private": false,
  "version": "1.0.5",
  "sideEffects": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/madebyoutloud/model"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "model",
    "data",
    "transformation",
    "mapping"
  ],
  "scripts": {
    "dev": "vitest dev",
    "test": "vitest run",
    "build": "tsdown",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build",
    "release": "release-it -c .config/release-it.json"
  },
  "devDependencies": {
    "@outloud/oxfmt-config": "^2.0.2",
    "@outloud/oxlint-config": "^2.0.2",
    "@types/node": "^22.13.9",
    "dayjs": "^1.11.13",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "release-it": "^18.1.2",
    "tsdown": "^0.15.12",
    "typescript": "~5.8.2",
    "vitest": "^2.0.5"
  }
}
