{
  "name": "@outloud/model",
  "type": "module",
  "version": "1.0.5",
  "description": "Maps plain data, such as API responses, to typed model classes with dates, relationships and getters.",
  "homepage": "https://docs.outloud.dev/model",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madebyoutloud/model.git"
  },
  "license": "MIT",
  "author": "Outloud (https://outloud.co)",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "migrations",
    "skills"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "keywords": [
    "model",
    "data",
    "mapping",
    "api",
    "typescript"
  ],
  "scripts": {
    "dev": "vitest dev",
    "test": "vitest run",
    "build": "tsdown",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build",
    "release": "release-it"
  },
  "devDependencies": {
    "@outloud/oxfmt-config": "^2.0.2",
    "@outloud/oxlint-config": "^2.0.2",
    "@types/node": "^22.13.9",
    "dayjs": "^1.11.13",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "release-it": "^18.1.2",
    "tsdown": "^0.15.12",
    "typescript": "~5.8.2",
    "vitest": "^2.0.5"
  }
}
